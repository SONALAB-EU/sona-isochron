# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Audio — never commit
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
*.aac

# More weight formats
*.pth
*.onnx
*.h5
*.npz

# Caches
.cache/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hf_cache/
huggingface/

# Raw experiment outputs
results/raw/

# HPC job logs (hpc/pipeline.sh)
hpc/logs/
hpc/gates/

# The commit hpc/sync.sh records in the cluster copy (never in this checkout)
/.git_commit

# make run writes here
output/

# Audio for the time check and the demo (isochron.time_check): never committed
/audio/

# Ratings returned by the native speaker: only the .xlsx is committed; the original .numbers file can carry
# the rater's name in its metadata
/results/native_check/returned/*.numbers

# The demo video: the narration recordings and everything built from them (demo/build_video.py)
/demo/narration/
/demo/out/
